# Mastodon instance base URL (no trailing slash required)
MASTODON_INSTANCE=https://mastodon.social

# Access token from instance → Preferences → Development → New application
# Scopes: read write:statuses write:media
MASTODON_ACCESS_TOKEN=

# Safety — keep 1 until you intentionally publish
MASTODON_DRY_RUN=1
MASTODON_REQUIRE_OUTBOX_APPROVAL=1

# Ports
MASTODON_BACKEND_PORT=10754
# Frontend Vite: 10755 (vite.config / start.ps1)

# Optional multi-account later
# MASTODON_ACCOUNTS_JSON=[]
