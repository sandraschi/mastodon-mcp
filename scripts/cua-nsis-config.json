  "bridge_ok_text": "REST bridge reachable",
  "uninstall_registry_filter": "*Mastodon MCP*",
  "frontend_port": 10755,
  "nav_routes": [
    [
      "Dashboard",
      "Dashboard"
    ],
    [
      "Timelines",
      "Timelines"
    ],
    [
      "Compose",
      "Compose"
    ],
    [
      "Inbox",
      "Inbox"
    ],
    [
      "Outbox",
      "Outbox"
    ],
    [
      "Accounts",
      "Accounts"
    ],
    [
      "Tools",
      "Tools"
    ],
    [
      "Settings",
      "Settings"
    ],
    [
      "Help",
      "Help"
    ]
  ],
  "sidebar_click_x": 30,
