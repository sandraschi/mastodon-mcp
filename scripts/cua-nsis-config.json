{
  "product_name": "Mastodon MCP",
  "install_dir": "%LOCALAPPDATA%\\Mastodon MCP",
  "operator_exe": "mastodon-mcp-native.exe",
  "backend_process_names": [
    "mastodon-mcp-native",
    "mastodon-mcp-backend"
  ],
  "backend_port": 10754,
  "health_path": "/health",
